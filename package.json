{
  "name": "@povio/scaffold",
  "version": "1.3.4",
  "author": "Marko Zabreznik <marko.zabreznik@povio.com> (https://zabreznik.net)",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsup",
    "cli": "DEBUG_COLORS=1 DEBUG='scaffold:*' node -r @swc-node/register src/cli.ts",
    "test": "DEBUG_COLORS=1 DEBUG='scaffold:*' node --test -r @swc-node/register src/**/*.test.ts",
    "test:watch": "DEBUG_COLORS=1 DEBUG='scaffold:*' node --test --watch -r @swc-node/register src/**/*.test.ts",
    "lint": "biome check  --write .",
    "lint:check": "biome check",
    "push": "yarn exec ./scripts/publish.sh"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "bin": "dist/cli.js",
  "dependencies": {
    "@types/debug": "^4.1.12",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.33",
    "colorette": "^2.0.20",
    "cosmiconfig": "^9.0.0",
    "debug": "^4.4.3",
    "fast-glob": "^3.3.3",
    "interpret": "^3.1.1",
    "lodash": "^4.17.21",
    "rechoir": "^0.8.0",
    "semver": "^7.7.3",
    "supports-color": "^10.2.2",
    "ts-morph": "^27.0.0",
    "yaml": "^2.8.1",
    "yargs": "^18.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "1.13.20",
    "@types/interpret": "^1.1.3",
    "@types/lodash": "^4.17.20",
    "@types/rechoir": "^0.6.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.10.3"
}
