{
  "name": "@povio/scaffold",
  "version": "1.4.0",
  "author": "Marko Zabreznik <marko.zabreznik@povio.com> (https://zabreznik.net)",
  "description": "Scaffolding tool for TypeScript projects",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsup",
    "cli": "DEBUG_COLORS=1 DEBUG='scaffold:*' node -r @swc-node/register src/sh.ts",
    "test": "DEBUG_COLORS=1 DEBUG='scaffold:*' node --test -r @swc-node/register src/**/*.test.ts",
    "test:watch": "DEBUG_COLORS=1 DEBUG='scaffold:*' node --test --watch -r @swc-node/register src/**/*.test.ts",
    "lint": "biome check  --write .",
    "lint:check": "biome check",
    "push": "yarn exec ./scripts/publish.sh"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./plugins/colorette": {
      "types": "./dist/plugins/colorette.d.ts",
      "import": "./dist/plugins/colorette.js"
    },
    "./plugins/debug": {
      "types": "./dist/plugins/debug.d.ts",
      "import": "./dist/plugins/debug.js"
    },
    "./plugins/fast-glob": {
      "types": "./dist/plugins/fast-glob.d.ts",
      "import": "./dist/plugins/fast-glob.js"
    },
    "./plugins/lodash": {
      "types": "./dist/plugins/lodash.d.ts",
      "import": "./dist/plugins/lodash.js"
    },
    "./plugins/semver": {
      "types": "./dist/plugins/semver.d.ts",
      "import": "./dist/plugins/semver.js"
    },
    "./plugins/ts-morph": {
      "types": "./dist/plugins/ts-morph.d.ts",
      "import": "./dist/plugins/ts-morph.js"
    },
    "./plugins/yaml": {
      "types": "./dist/plugins/yaml.d.ts",
      "import": "./dist/plugins/yaml.js"
    },
    "./plugins/zod": {
      "types": "./dist/plugins/zod.d.ts",
      "import": "./dist/plugins/zod.js"
    }
  },
  "typesVersions": {
    "*": {
      "plugins/colorette": ["dist/plugins/colorette.d.ts"],
      "plugins/debug": ["dist/plugins/debug.d.ts"],
      "plugins/fast-glob": ["dist/plugins/fast-glob.d.ts"],
      "plugins/lodash": ["dist/plugins/lodash.d.ts"],
      "plugins/semver": ["dist/plugins/semver.d.ts"],
      "plugins/ts-morph": ["dist/plugins/ts-morph.d.ts"],
      "plugins/yaml": ["dist/plugins/yaml.d.ts"],
      "plugins/zod": ["dist/plugins/zod.d.ts"]
    }
  },
  "bin": "dist/sh.js",
  "dependencies": {
    "colorette": "^2.0.20",
    "debug": "^4.4.3",
    "fast-glob": "^3.3.3",
    "interpret": "^3.1.1",
    "lodash": "^4.17.21",
    "rechoir": "^0.8.0",
    "semver": "^7.7.3",
    "ts-morph": "^27.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "1.13.20",
    "@types/debug": "^4.1.12",
    "@types/interpret": "^1.1.3",
    "@types/lodash": "^4.17.20",
    "@types/rechoir": "^0.6.4",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.10.3"
}
